{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default desktop capability for ApiForge",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    "process:allow-restart",
    "updater:default",
    "stronghold:default",
    "stronghold:allow-remove-store-record",
    "stronghold:allow-destroy"
  ]
}
